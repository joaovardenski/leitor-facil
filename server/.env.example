# Copie este arquivo para .env (aqui na pasta server) e cole a sua chave.
# O .env não vai para o GitHub. Sem nenhuma chave, o servidor usa só o Tesseract.

# Chave do Gemini (grátis, sem cartão): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: modelos do Gemini, tentados em ordem (se um estiver sobrecarregado,
# tenta o próximo). Padrão: gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-lite-latest
# GEMINI_MODELO=gemini-3.1-flash-lite,gemini-3.5-flash-lite

# Opcional: chave do Google Cloud Vision, para trocar de motor no futuro
# GOOGLE_VISION_API_KEY=

# Opcional: forçar um motor (gemini, google-vision ou tesseract).
# Sem isso, usa o primeiro que tiver chave: Gemini, depois Google Vision.
# OCR_MOTOR=gemini

# Opcional: prazo total, em segundos, para o Gemini (somando as tentativas).
# Passou disso, o servidor usa o Tesseract. Padrão: 25
# GEMINI_TEMPO_LIMITE=25

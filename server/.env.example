# Copie este arquivo para .env (aqui na pasta server) e cole a sua chave.
# O .env não vai para o GitHub. Sem nenhuma chave, o servidor usa só o Tesseract.

# Chave do Gemini (grátis, sem cartão): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: outro modelo do Gemini (padrão: gemini-3.5-flash-lite)
# GEMINI_MODELO=gemini-3.8-flash

# Opcional: chave do Google Cloud Vision, para trocar de motor no futuro
# GOOGLE_VISION_API_KEY=

# Opcional: forçar um motor (gemini, google-vision ou tesseract).
# Sem isso, usa o primeiro que tiver chave: Gemini, depois Google Vision.
# OCR_MOTOR=gemini

# Opcional: quantos segundos esperar o Gemini antes de usar o Tesseract (padrão: 30)
# GEMINI_TEMPO_LIMITE=30

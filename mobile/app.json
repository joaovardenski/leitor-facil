{
  "expo": {
    "name": "Leitor Fácil",
    "slug": "leitor-facil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Leitor Fácil usa a câmera para fotografar o papel que você quer ler.",
          "photosPermission": "O Leitor Fácil acessa suas fotos para ler o texto de uma imagem já salva."
        }
      ],
      "expo-sqlite"
    ]
  }
}
